{
  "name": "stocksense-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.js",
    "create-manager": "node --env-file-if-exists=.env src/scripts/create-manager.js",
    "test": "node --env-file-if-exists=.env --import ./test/setup.js --test --test-concurrency=1 'test/*.test.js'"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  }
}
