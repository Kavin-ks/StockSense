FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm ci --omit=dev
COPY src ./src
RUN mkdir -p public/uploads/avatars && chown -R node:node public
USER node
EXPOSE 4000
# Apply pending migrations, then start the API.
CMD ["sh", "-c", "node src/db/migrate.js && node src/server.js"]
