PORT=4000
DATABASE_URL=postgres://localhost:5432/stocksense
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
# Brevo / SMTP configuration for OTP e-mails. When unset, OTPs are printed to the server log (dev mode).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM="StockSense <no-reply@stocksense.local>"

# First Inventory Manager, used only by `npm run create-manager` (keep real values out of git).
MANAGER_LOGIN_ID=
MANAGER_NAME=
MANAGER_EMAIL=
MANAGER_PASSWORD=
